generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ADMIN ──────────────────────────────────────────────────
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(VIEWER)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

// ── CONTACT INQUIRIES ──────────────────────────────────────
model ContactInquiry {
  id        String        @id @default(cuid())
  name      String
  company   String?
  email     String
  phone     String?
  message   String        @db.Text
  type      InquiryType   @default(GENERAL)
  status    InquiryStatus @default(NEW)
  notes     String?       @db.Text  // internal admin notes
  ipHash    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@map("contact_inquiries")
}

// ── ORDER REQUESTS ─────────────────────────────────────────
model OrderRequest {
  id           String      @id @default(cuid())
  companyName  String
  contactName  String
  email        String
  phone        String?
  varietyIds   String[]
  estimatedQty String
  deliveryDate DateTime?
  regions      String[]
  notes        String?     @db.Text
  internalNotes String?    @db.Text
  status       OrderStatus @default(PENDING)
  quotedAt     DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([email])
  @@map("order_requests")
}

// ── NEWSLETTER ─────────────────────────────────────────────
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscribers")
}

// ── CONTENT (CMS-ready) ────────────────────────────────────
model ContentBlock {
  id        String      @id @default(cuid())
  key       String      @unique  // e.g. "hero.headline", "about.body"
  value     String      @db.Text
  type      ContentType @default(TEXT)
  updatedBy String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([key])
  @@map("content_blocks")
}

// ── ENUMS ──────────────────────────────────────────────────
enum AdminRole    { SUPER_ADMIN ADMIN VIEWER }
enum InquiryType  { GENERAL WHOLESALE LOGISTICS MEDIA }
enum InquiryStatus{ NEW READ REPLIED ARCHIVED }
enum OrderStatus  { PENDING REVIEWING QUOTED CONFIRMED DECLINED }
enum ContentType  { TEXT HTML MARKDOWN IMAGE_URL }
